source "${PORTAGE_BIN_PATH:?}"/isolated-functions.sh || exit

option_r=
if ___eapi_dosym_has_relative && [[ ${1} == -r ]]; then
	option_r=t
	shift
fi

if [[ $# -ne 2 ]] ; then
	__helpers_die "${0##*/}: two arguments needed"
	exit 1
fi

if ! ___eapi_has_prefix_vars; then
	ED=${D}
fi

if [[ ${2} == */ ]] || [[ -d ${ED%/}/${2#/} && ! -L ${ED%/}/${2#/} ]] ; then
	# implicit basename not allowed by PMS (bug #379899)
	__helpers_die "${0##*/}: dosym target omits basename: '${2}'"
fi

target=${1}

if [[ ${option_r} ]]; then
	# Canonicalize the absolute pathname given by the first parameter,
	# in the manner of GNU realpath(1) with the -m and -s options, and
	# assign the result to REPLY. Discard empty and dot components;
	# each dot-dot removes the preceding component, if any. Neither
	# the existence of the pathname nor symbolic links are taken into
	# account.
	dosym_canonicalize() {
		local comp IFS -

		IFS=/
		set -f
		REPLY=
		for comp in $1; do
			case ${comp} in
				''|.)
					;;
				..)
					REPLY=${REPLY%/*}
					;;
				*)
					REPLY+=/${comp}
			esac
		done
		REPLY=${REPLY:-/}
	}

	# Expansion makes sense only for an absolute target path
	[[ ${target} == /* ]] || __helpers_die \
		"${0##*/}: -r specified but no absolute target path: '${target}'"

	target=${| dosym_canonicalize "${target}"; }
	linkdir=${| dosym_canonicalize "/${2#/}"; }
	linkdir=${linkdir%/*}	# poor man's dirname(1)
	linkdir=${linkdir:-/}	# always keep the initial "/"

	set -f
	IFS=/
	for comp in ${linkdir}; do
		if [[ ${target%%/*} == "${comp}" ]]; then
			target=${target#"${comp}"}
			target=${target#/}
		else
			target=..${target:+/}${target}
		fi
	done
	unset IFS
	set +f
	target=${target:-.}
fi

destdir=${2%/*}
[[ ! -d ${ED%/}/${destdir#/} ]] && dodir "${destdir}"
ln -snf "${target}" "${ED%/}/${2#/}"

ret=${?}
[[ ${ret} -ne 0 ]] && __helpers_die "${0##*/} failed"
exit ${ret}

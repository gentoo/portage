source "${PORTAGE_BIN_PATH:?}"/isolated-functions.sh || exit

if ! ___eapi_has_prefix_vars; then
	ED=${D}
	EROOT=${ROOT}
fi

if ___eapi_has_SYSROOT && [[ ${EBUILD_PHASE} == install ]]; then
	PWDB_ROOT=${SYSROOT}
	PWDB_EROOT=${ESYSROOT}
else
	PWDB_ROOT=${ROOT%/}
	PWDB_EROOT=${EROOT%/}
fi

# Assigns REPLY the numeric form of the owner given by the first parameter,
# resolving any names against the passwd and group files of the custom root.
__resolve_owner() {
	local owner=$1
	local pwdb_path pw_gid group name user gid uid

	pwdb_path=${PWDB_EROOT}/etc

	IFS=':' read -r user group <<< "${owner}"

	if [[ ${user} ]]; then
		if [[ ${user} == +([0-9]) ]]; then
			uid=${user}
		else
			while IFS=: read -r name _ uid pw_gid _ || [[ ${name} ]]; do
				[[ ${name} == "${user}" ]] && break
			done < "${pwdb_path}"/passwd
			if [[ ${uid} != +([0-9]) ]]; then
				__helpers_die "fowners: invalid user in ${pwdb_path}/passwd: ${owner}"
				return
			fi
		fi
	fi

	if [[ ${group} ]]; then
		if [[ ${group} == +([0-9]) ]]; then
			gid=${group}
		else
			while IFS=: read -r name _ gid _ || [[ ${name} ]]; do
				[[ ${name} == "${group}" ]] && break
			done < "${pwdb_path}"/group
			if [[ ${gid} != +([0-9]) ]]; then
				__helpers_die "fowners: invalid group in ${pwdb_path}/group: ${owner}"
				return
			fi
		fi
		gid=:${gid}
	elif [[ ${owner} == *: ]]; then
		# `chown uid:` is invalid with numeric-uid-gid, use the primary group defined above
		if [[ ${pw_gid} == +([0-9]) ]]; then
			gid=:${pw_gid}
		else
			__helpers_die "fowners: invalid primary group for ${user} in ${pwdb_path}/passwd: ${owner}"
			return
		fi
	fi

	REPLY=${uid}${gid}
}

args=()
got_owner=
for arg; do
	if [[ ${arg} == -* ]]; then
		args+=( "${arg}" )
	elif [[ ! ${got_owner} ]]; then
		# the first non-option is the owner and must not be prefixed
		got_owner=1
		# use numeric-uid-gid from the custom target root
		if [[ -n ${PWDB_ROOT} ]]; then
			owner=${| __resolve_owner "${arg}"; } || exit
			args+=( "${owner}" )
		else
			args+=( "${arg}" )
		fi
	else
		args+=( "${ED%/}/${arg#/}" )
	fi
done

chown "${args[@]}"
ret=$?

[[ ${ret} -ne 0 ]] && __helpers_die "${0##*/} failed"
exit ${ret}
